# Finance Suite environment template
# Copy this file to `.env` and fill in real values on the server.
# Do not commit real credentials.

# JQData / JoinQuant
JQDATA_USERNAME=
JQDATA_PASSWORD=

# Tushare Pro
TUSHARE_TOKEN=

# Search providers. Multiple keys are comma-separated.
TAVILY_KEYS=
BRAVE_KEYS=

# Video transcript provider
SUPADATA_API_KEY=

# Runtime
LOG_LEVEL=INFO
CACHE_DIR=/tmp/finance-suite-cache
